[Unit]
Description=SlicerWebSub worker control panel
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=mbellehumeur
Group=mbellehumeur
SupplementaryGroups=docker
WorkingDirectory=/home/mbellehumeur/src/SlicerWebSub-workers
Environment=PATH=/home/mbellehumeur/src/SlicerWebSub-workers/.venv/bin:/usr/bin
ExecStart=/home/mbellehumeur/src/SlicerWebSub-workers/.venv/bin/python -m control --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
